  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Chores</h2>

    <section id="chores">

        {% for chore in chores %}

            
            <div class="chore  {% if chore.done %}done{% endif %}">
                <p class="priority">{{ chore.priority }}</p>
                
                <h3>{{ chore.chore_name }}</h3>
                
                <p class="person">{{ chore.person_name }}</p>
                
                {% if chore.done %} 
                    <a class="done-toggle" href="/chore/{{ chore.id }}/incomplete">🗹</a> 
                {% else %} 

                    <a class="done-toggle" href="/chore/{{ chore.id }}/complete">☐</a> 
                {% endif %}

                {% if chore %}    
                    <a class="delete-toggle" onclick="return confirm('Are you sure you want to delete this?')" href="/chore/{{ chore.id }}/delete"> <img src="/static/images/trashbin.png" alt="bin Icon" class="delete"></a>
                {% endif %}

            </div>

        {% else %}

            <p>No Chores!</p>

        {% endfor %}

    </section>

