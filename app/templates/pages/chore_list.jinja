{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Chores</h2>

    <section id="chores">

        {% for chore in chores %}

            
            <div class="chore">
                <h3>{{ chore.name }}</h3>
                <p>Chore: <strong>{{ chore.name }}</strong></p>
                <p><a href="/chore/{{ chore.id }}/delete">Delete</a></p>
 

            </div>

        {% else %}

            <p>No Chores!</p>

        {% endfor %}

    </section>

{% endblock %}

