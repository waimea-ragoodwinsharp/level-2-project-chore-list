{% extends 'pages/_base.jinja' %}

{% block content %}
<section id="choreform">
    <h2>Add a chore</h2>

    <form method="post" action="/chore/new">
        <label>


            Name
            <input type="text" name="name" placeholder="e.g. Pick up cats" required>
        
        </label>

        <label>

            Person
            <select name="person">
                {% for person in persons %}
                    <option value="{{ person.id }}">{{ person.name }}</option>
                {% endfor %}
            </select>
            
        </label>

        <label>

            Priority
            <input type="number" name="priority" min="1" max="5" value="3" required>

        </label>



        <button>Add Chore</button>
        
    </form>

</section>
{% endblock %}